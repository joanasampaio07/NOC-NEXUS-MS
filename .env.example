# Configurações do Zabbix (6.x ou 7.x)
ZABBIX_URL=https://zabbix.cabeceiras.pi.gov.br/api_jsonrpc.php
ZABBIX_API_TOKEN=seu_token_api_aqui_gerado_no_zabbix

# Hostgroups configurados no Zabbix
HOSTGROUP_ESCOLAS=CAB/PI / ESCOLAS
HOSTGROUP_CORE=CAB/PI / CORE

# Configurações do Servidor Local do Dashboard (Opcional)
PORT=8080
HOST=0.0.0.0

