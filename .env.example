# Configurações do Zabbix (6.x ou 7.x)
ZABBIX_URL=https://zabbix.nexus-ms.local/api_jsonrpc.php
ZABBIX_API_TOKEN=seu_token_api_aqui_gerado_no_zabbix

# Hostgroups configurados no Zabbix
HOSTGROUP_ESCOLAS=NEXUS-MS / UNIDADES
HOSTGROUP_CORE=NEXUS-MS / CORE

# Configurações do Servidor Local do Dashboard (Porta 80 HTTP Padrão)
PORT=80
HOST=0.0.0.0
